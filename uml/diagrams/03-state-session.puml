@startuml 03-state-session
!theme plain
title TypePulse — диаграмма состояний TrainingSession (VIEW-007)

[*] --> CREATED : POST /training/start\n(создание сеанса)

CREATED --> RUNNING : сеанс активирован\n(текст выдан, таймер запущен)

state RUNNING {
  [*] --> AcceptingInput
  AcceptingInput : приём символов\nподсветка\nlive-WPM
  AcceptingInput --> AcceptingInput : keystroke
}

RUNNING --> FINISHED : таймер истёк\nили текст исчерпан\n+ успешный finish
RUNNING --> CANCELLED : обрыв сети /\nявная отмена /\nошибка сохранения

FINISHED --> [*] : Result сохранён\n(неизменяемый)
CANCELLED --> [*] : Result не создан\nкак успешный

note right of FINISHED
  Постусловие UC-06:
  метрики зафиксированы,
  запись в истории.
end note

note right of CANCELLED
  REQ-REL-001:
  частичный результат
  не считается успехом.
end note

@enduml
