@startuml 02-activity-training
!theme plain
title TypePulse — диаграмма активности: проведение тренировки (UC-05 / UC-06)
start

:Открыть настройку тренировки;
:Выбрать язык, длительность, сложность;

if (Использовать свой текст?) then (да)
  :Выбрать / загрузить TextSnippet;
else (нет)
  :Взять текст из каталога;
endif

:Нажать «Старт»;
:Создать сеанс RUNNING;
:Показать эталонный текст и фокус на вводе;

while (Текст не исчерпан И время не истекло?) is (да)
  :Принять символ с клавиатуры;
  if (Символ совпадает с эталоном?) then (да)
    :Подсветить как верный;
    :Увеличить correctChars;
  else (нет)
    :Подсветить как ошибку;
    :Увеличить errors;
  endif
  :Обновить live-WPM в UI;
endwhile (нет)

if (Соединение потеряно?) then (да)
  :Статус CANCELLED;
  :Сообщить пользователю;
  :Не сохранять Result;
  stop
else (нет)
endif

:Отправить finish на сервер;
:Рассчитать WPM, accuracy, errors;
:Статус FINISHED;
:Сохранить Result;
:Показать экран результата;

stop
@enduml
