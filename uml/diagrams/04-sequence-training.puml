@startuml
title TypePulse - sequence: training to result (UC-05 / UC-06)

actor User
participant "Web UI" as UI
participant "TrainingController" as TC
participant "TrainingService" as TS
participant "MetricsService" as MS
participant "Database" as DB

== Setup and start ==
User -> UI : Choose language / duration / difficulty
User -> UI : Press Start
UI -> TC : POST /training/start
activate TC
TC -> TS : startSession(user, params)
activate TS
TS -> DB : save session RUNNING
DB --> TS : sessionId + text
TS --> TC : sessionId + text
deactivate TS
TC --> UI : 200 + session payload
deactivate TC
UI --> User : Focus input, timer, text

== Typing (local, <= 100 ms) ==
loop While session running
  User -> UI : keystroke
  UI -> UI : highlight + live WPM
end

== Finish ==
User -> UI : timer expired / text done
UI -> TC : POST /training/id/finish
activate TC
TC -> TS : finish(sessionId, typedText, elapsedMs)
activate TS

alt Session RUNNING
  TS -> MS : calculate(correct, typed, elapsedMs)
  activate MS
  MS --> TS : wpm, accuracy, errors
  deactivate MS
  TS -> DB : FINISHED + save Result
  DB --> TS : ok
  TS --> TC : metrics + resultId
  TC --> UI : result screen
  UI --> User : WPM, accuracy, errors
else Already FINISHED/CANCELLED or network loss
  TS --> TC : error / cancel
  TC --> UI : no successful Result
  UI --> User : session cancelled
end

deactivate TS
deactivate TC

note over UI, MS #FFCCCC
  Lab5 legend (red note):
  solid arrow = sync call
  dashed arrow = return
  activate/deactivate = activation bar
  alt/else = alternatives
  loop = repeated keystrokes
end note

@enduml
